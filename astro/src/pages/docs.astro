import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Bird documentation — PDF/AI import, SVG/PDF export, API"
  description="Bird documentation: getting started, keyboard shortcuts, PDF/AI/EPS import, SVG/PDF export, JavaScript API, Astro and Rust builds."
>
  <div class="docs">
    <nav class="docs-nav" aria-label="Contents">
      <span class="group">Get started</span>
      <a href="#start">Getting started</a>
      <a href="#shortcuts">Shortcuts</a>
      <span class="group">Formats</span>
      <a href="#import">Import</a>
      <a href="#export">Export</a>
      <a href="#limits">Known limits</a>
      <span class="group">Integration</span>
      <a href="#api">JavaScript API</a>
